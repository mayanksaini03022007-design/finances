
# Environment variables for the application
# Copy this file to .env and fill in the values for local development

# The port the server will listen on
PORT=3000

# A secret key for signing JWTs (JSON Web Tokens).
# It should be a long, random string (at least 32 characters).
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The connection string for your MongoDB database.
# For a local MongoDB instance, it might look like: mongodb://127.0.0.1:27017/deeya-invest
# For MongoDB Atlas, you'll get a connection string from their dashboard.
MONGODB_URI=

# The ID for the admin user
ADMIN_ID=admin

# The password for the admin user
ADMIN_PASSWORD=admin123

# The allowed origin for CORS (Cross-Origin Resource Sharing).
# For local development, you can set this to '*' to allow all origins.
# In production, you should restrict this to the domain of your frontend application.
ALLOWED_ORIGIN=*